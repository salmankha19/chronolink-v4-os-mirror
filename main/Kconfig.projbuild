menu "ChronoLink HAL Board Pins"

config BOARD_LCD_CS
    int "LCD CS GPIO"
    range -1 48
    default 7
    help
        Chip-select pin for ST7796S display SPI device. PCB: IO7.

config BOARD_LCD_DC
    int "LCD D/C GPIO"
    range -1 48
    default 10
    help
        Data/Command select pin for ST7796S display. PCB: IO10.

config BOARD_LCD_RST
    int "LCD Reset GPIO"
    range -1 48
    default 16
    help
        Reset pin for ST7796S display. PCB: IO16.

config BOARD_LCD_BL
    int "LCD Backlight GPIO"
    range -1 48
    default 8
    help
        Backlight control pin for ST7796S display. PCB: IO8.

config BOARD_I2C_SDA
    int "I2C SDA GPIO"
    range -1 48
    default 18
    help
        SDA pin for HAL I2C master. PCB: IO18.

config BOARD_I2C_SCL
    int "I2C SCL GPIO"
    range -1 48
    default 17
    help
        SCL pin for HAL I2C master. PCB: IO17.

config BOARD_AUDIO_I2S_BCLK
    int "Audio I2S BCLK GPIO"
    range -1 48
    default 47
    help
        I2S bit clock pin for the MAX98357A amplifier. PCB: IO47.

config BOARD_AUDIO_I2S_WS
    int "Audio I2S WS (LRCLK) GPIO"
    range -1 48
    default 48
    help
        I2S word-select (LRCLK) pin for the MAX98357A amplifier. PCB: IO48.

config BOARD_AUDIO_I2S_DOUT
    int "Audio I2S DOUT GPIO"
    range -1 48
    default 21
    help
        I2S data-out pin for the MAX98357A amplifier. PCB: IO21.

config BOARD_AUDIO_SD_MODE
    int "Audio SD_MODE GPIO (-1 to disable)"
    range -1 48
    default -1
    help
        Optional shutdown/mode-select pin for the MAX98357A.
        PCB v4 leaves this unconnected, so keep at -1.

endmenu