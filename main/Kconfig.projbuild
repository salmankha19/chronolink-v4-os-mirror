menu "ChronoLink HAL Board Pins"

config BOARD_LCD_CS
    int "LCD CS GPIO"
    range -1 48
    default 7
    help
        Chip-select pin for ST7796S display SPI device. PCB: IO7.

config BOARD_LCD_DC
    int "LCD D/C GPIO"
    range -1 48
    default 10
    help
        Data/Command select pin for ST7796S display. PCB: IO10.

config BOARD_LCD_RST
    int "LCD Reset GPIO"
    range -1 48
    default 16
    help
        Reset pin for ST7796S display. PCB: IO16.

config BOARD_LCD_BL
    int "LCD Backlight GPIO"
    range -1 48
    default 8
    help
        Backlight control pin for ST7796S display. PCB: IO8.

config BOARD_I2C_SDA
    int "I2C SDA GPIO"
    range -1 48
    default 18
    help
        SDA pin for HAL I2C master. PCB: IO18.

config BOARD_I2C_SCL
    int "I2C SCL GPIO"
    range -1 48
    default 17
    help
        SCL pin for HAL I2C master. PCB: IO17.

config BOARD_AUDIO_I2S_BCLK
    int "Audio I2S BCLK GPIO"
    range -1 48
    default 47
    help
        I2S bit clock pin for the MAX98357A amplifier. PCB: IO47.

config BOARD_AUDIO_I2S_WS
    int "Audio I2S WS (LRCLK) GPIO"
    range -1 48
    default 48
    help
        I2S word-select (LRCLK) pin for the MAX98357A amplifier. PCB: IO48.

config BOARD_AUDIO_I2S_DOUT
    int "Audio I2S DOUT GPIO"
    range -1 48
    default 21
    help
        I2S data-out pin for the MAX98357A amplifier. PCB: IO21.

config BOARD_AUDIO_SD_MODE
    int "Audio SD_MODE GPIO (-1 to disable)"
    range -1 48
    default -1
    help
        Optional shutdown/mode-select pin for the MAX98357A.
        PCB v4 leaves this unconnected, so keep at -1.

endmenu


menu "ChronoLink Display Configuration"

choice BOARD_DISPLAY_TYPE
    prompt "Select display driver"
    default BOARD_DISPLAY_ST7796S
    help
        Choose which display backend ChronoLink HAL should use.
        Only one display driver is compiled into the firmware.

config BOARD_DISPLAY_NONE
    bool "No display"
    help
        Disable all display drivers. Useful for headless builds.

config BOARD_DISPLAY_ST7796S
    bool "ST7796S SPI LCD"
    help
        Use the ST7796S TFT LCD driver.

config BOARD_DISPLAY_MAX7219
    bool "MAX7219 LED Matrix"
    help
        Use the MAX7219 LED matrix driver.

config BOARD_DISPLAY_REMOTE
    bool "Remote display (future)"
    help
        Use remote display backend (WiFi/HTTP/MQTT).

endchoice

endmenu