# Temporary developer defaults to reduce boot noise and allow local UI bring-up
CONFIG_I2C_SUPPRESS_DEPRECATE_WARN=y
# Optional during transition when legacy/new I2C APIs coexist
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

# Match the PlatformIO flash size to the actual module flash so build warnings disappear
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# CONFIG_ESPTOOLPY_FLASHSIZE_2MB is not set

# CONFIG_CHRONOLINK_USE_MOCK_DISPLAY is not set
CONFIG_CHRONOLINK_HAL_DISPLAY_BACKEND_ST7796S=y

# Align the Kconfig partition-table choice with platformio.ini's
# board_build.partitions = partitions.csv. Without this, an
# ESP-IDF-native build (idf.py build) uses the built-in
# partitions_singleapp.csv instead of our two-slot OTA layout.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# svc_time configures up to three NTP servers (NVS namespace "time", keys
# ntp_server_0 .. ntp_server_2). Must be >= the number of servers svc_time
# tries, otherwise LwIP's sntp_setservername() silently ignores the extra
# slots. Changing this file does NOT take effect until sdkconfig.single_mcu
# (and ideally .pio/build/single_mcu) is deleted before the rebuild -- the
# persisted value (1) wins otherwise.
CONFIG_LWIP_SNTP_MAX_SERVERS=3
