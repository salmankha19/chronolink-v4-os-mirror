# ============================================================
# ChronoLink V4 -- .gitignore
# ============================================================

# ---------- ESP-IDF / PlatformIO generated config ----------
# These are BUILD ARTIFACTS. Never commit.
# The source of truth is sdkconfig.defaults (committed).
sdkconfig
sdkconfig.old
sdkconfig.single_mcu
sdkconfig.single_mcu_test
sdkconfig.split_mcu_main
sdkconfig.display_mcu
sdkconfig.esp32s3

# ---------- Build outputs ----------
build/
managed_components/
.pio/
.pioenvs/
.pio/build/
.pio/.cache/

# ---------- Compiled binaries and maps ----------
*.bin
*.elf
*.map
*.hex
*.bak
*.log
build_*.txt
pio_build_*.txt
pio_verbose*.txt

# ---------- IDE / editor ----------
.vscode/

# ---------- Build helper scripts and local logs ----------
build_idf.ps1
build_step_fullclean.log

# ---------- Compiled/binary archives ----------
*.zip

# ---------- Patch files (applied upstream) ----------
*.patch

# ---------- CMake / Ninja ----------
CMakeCache.txt
CMakeFiles/
ninja_compdb.json
compile_commands.json

# ---------- Cached Python ----------
__pycache__/
*.pyc
*.pyo

# ---------- Local logs ----------
bootlog.txt
chronolink_selected_dump.txt

# ---------- Test harness ----------
# Per-run postmortems (run.log / expected.txt / diff.txt / result.txt) are
# local evidence, not source. Keep them out of the tree.
test_harness/results/

# ---------- Local commit-message temp files ----------
commit-msg.txt
pr-body.txt

# ============================================================
# IMPORTANT: sdkconfig.defaults is NOT ignored -- it is the
# single source of truth for pin configuration. Keep it
# committed.
# ============================================================
*.tmp

# Compiled object files (never commit)
*.o
*.o.*

# Working documents (not committed)
docs/session*-cline-prompt.md
docs/session*-plan.md
docs/session*-prompt.md

platformio.local.ini